PORT=3001
ADMIN_API_URL=https://devops.benevolaite.com

# Beta routing auto-sync (see betaSync.js) — set all four to enable.
# When unset, the app runs fine but does NOT auto-manage the ALB rule;
# it'll log a warning at startup and skip syncing.
AWS_REGION=us-east-1
ECS_CLUSTER=golf-demo-cluster
ECS_BETA_SERVICE=golf-demo-app-beta
ECS_PROD_SERVICE=golf-demo-app-prod
ALB_LISTENER_RULE_ARN=arn:aws:elasticloadbalancing:us-east-1:393886308751:listener-rule/app/.../.../...
